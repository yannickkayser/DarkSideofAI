init.type  = "LDA",
seed       = SEED,
verbose    = TRUE
)
})
cat(sprintf("\n  Done in %.0f seconds.\n", t_prelim["elapsed"]))
cat(sprintf("\n  Done in %.0f seconds.\n", t_prelim["elapsed"]))
