print(sig[, c("topic_id","frex_label","estimate","ci_lower","ci_upper","direction")])
saveRDS(prev_df, file.path(OUTPUT_DIR, "prev_df.rds"))
if (!is.null(content_formula)) {
banner("Step 4 — Content covariate: sageLabels()  [H1c]")
cat("  Extracting per-audience word distributions ...\n\n")
sage <- sageLabels(stm_model, n = 10)
print(sage)
cat("\n  Reading guide:\n")
cat("    sage$wordcov$audience[[1]] = words used by CLIENT pages for each topic\n")
cat("    sage$wordcov$audience[[2]] = words used by WORKER pages for each topic\n")
cat("    Strong divergence within a topic = evidence for H1c.\n\n")
} else {
banner("Step 4 — Content covariate: skipped (three-level audience)")
sage <- NULL
}
banner("Step 5 — Topic correlations")
topic_corr <- topicCorr(stm_model, method = "simple", cutoff = 0.01)
plot(topic_corr,
main = sprintf("Topic correlation network (K=%d)", K))
banner("Step 6 — Hypothesis vocabulary alignment check")
all_labels  <- labelTopics(stm_model, n = 15)
topic_terms <- setNames(
lapply(seq_len(K), function(t) all_labels$frex[t, ]),
paste0("T", seq_len(K))
)
cat(sprintf("  %-8s", "Topic"))
for (h in names(HYPOTHESIS_VOCAB)) cat(sprintf("  %-6s", h))
cat("\n  ", paste(rep("-", 8 + 8 * length(HYPOTHESIS_VOCAB)), collapse=""), "\n", sep="")
for (t in seq_len(K)) {
terms <- topic_terms[[t]]
cat(sprintf("  T%-6d", t))
for (h in names(HYPOTHESIS_VOCAB)) {
n_overlap <- sum(terms %in% HYPOTHESIS_VOCAB[[h]])
cat(sprintf("  %-6d", n_overlap))
}
frex5 <- paste(all_labels$frex[t, 1:5], collapse=", ")
cat(sprintf("  (%s)\n", frex5))
}
cat("\n  ✓ 03_fit_model.R complete.\n")
cat("  → Next: run 04_export.R to write CSVs for Python re-import.\n\n")
source("00_config.R")
load_packages()
banner("04 — Exporting STM results to CSV")
require_file(MODEL_RDS, hint = "Run 03_fit_model.R first")
require_file(OUT_RDS,   hint = "Run 01_prepare.R first")
stm_model <- readRDS(MODEL_RDS)
out       <- readRDS(OUT_RDS)
prev_df_path <- file.path(OUTPUT_DIR, "prev_df.rds")
require_file(prev_df_path, hint = "Run 03_fit_model.R first")
prev_df <- readRDS(prev_df_path)
cat(sprintf("  Model loaded  (K=%d)\n", stm_model$settings$dim$K))
cat(sprintf("  Documents    : %d\n",    length(out$documents)))
banner("Export 1 — Document-topic proportions (stm_theta.csv)")
theta     <- stm_model$theta                     # N × K matrix
top_idx   <- apply(theta, 1, which.max)
top_prop  <- apply(theta, 1, max)
topic_cols          <- as.data.frame(theta)
colnames(topic_cols) <- paste0("topic_", seq_len(ncol(theta)))
theta_df <- data.frame(
page_id        = out$meta$page_id,
audience       = as.character(out$meta$audience),
domain         = out$meta$domain,
topic_cols,
dominant_topic = top_idx,
dominant_prop  = round(top_prop, 6),
stringsAsFactors = FALSE
)
theta_path <- file.path(OUTPUT_DIR, "stm_theta.csv")
write.csv(theta_df, theta_path, row.names = FALSE)
cat(sprintf("  Rows : %d  |  Columns : %d\n", nrow(theta_df), ncol(theta_df)))
cat(sprintf("  Saved → %s\n", normalizePath(theta_path)))
banner("Export 2 — Topic term lists (stm_topic_terms.csv)")
N_TERMS <- 20
labels  <- labelTopics(stm_model, n = N_TERMS)
terms_df <- do.call(rbind, lapply(seq_len(K), function(t) {
data.frame(
topic_id  = t,
rank      = seq_len(N_TERMS),
prob_term = labels$prob[t, ],
frex_term = labels$frex[t, ],
stringsAsFactors = FALSE
)
}))
terms_path <- file.path(OUTPUT_DIR, "stm_topic_terms.csv")
write.csv(terms_df, terms_path, row.names = FALSE)
cat(sprintf("  Rows : %d  (K=%d × %d terms × 2 metrics)\n",
nrow(terms_df), K, N_TERMS))
terms_df <- lapply(seq_len(K), function(t) {
data.frame(
topic_id  = t,
rank      = seq_len(N_TERMS),
prob_term = labels$prob[t, ],
frex_term = labels$frex[t, ],
stringsAsFactors = FALSE
)
})
