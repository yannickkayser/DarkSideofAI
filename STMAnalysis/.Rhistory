#     output/step_1/stm/stm_model.rds  — fitted STM object
#     output/step_1/stm/prev_df.rds    — estimateEffect() data frame
#   01_prepare.R must have been run:
#     output/step_1/stm/out.rds        — prepDocuments() object (for meta)
#
# Produces (all written to output/step_1/stm/):
#   stm_theta.csv        — per-document topic proportions (θ matrix)
#   stm_topic_terms.csv  — top-N FREX & Prob terms per topic
#   stm_prevalence.csv   — audience prevalence effects from estimateEffect()
#   stm_content.csv      — per-audience word log-odds per topic  (H1c only;
#                          written only when BOTH_STRATEGY = "exclude")
#
# =============================================================================
source("00_config.R")
load_packages()
banner("04 — Exporting STM results to CSV")
require_file(MODEL_RDS, hint = "Run 03_fit_model.R first")
require_file(OUT_RDS,   hint = "Run 01_prepare.R first")
stm_model <- readRDS(MODEL_RDS)
out       <- readRDS(OUT_RDS)
prev_df_path <- file.path(OUTPUT_DIR, "prev_df.rds")
require_file(prev_df_path, hint = "Run 03_fit_model.R first")
prev_df <- readRDS(prev_df_path)
# Derive K from the model itself — never rely on the config value here,
# because if 00_config.R failed to source (e.g. DB not found) the K variable
# in the session could be stale from a previous .RData workspace.
K <- stm_model$settings$dim$K
cat(sprintf("  Model loaded  (K=%d)\n", K))
cat(sprintf("  Documents    : %d\n",    length(out$documents)))
# =============================================================================
# EXPORT 1 — Document-topic proportions  (θ matrix)
# =============================================================================
# stm_model$theta is a documents × K matrix of topic proportions.
# Each row sums to 1.  The dominant topic for each document is the column with
# the highest proportion.
#
# Columns:
#   page_id          — joins back to the Python corpus
#   audience         — client / worker  (from out$meta)
#   domain           — platform domain  (from out$meta)
#   topic_1 … topic_K — θ values
#   dominant_topic   — argmax topic index (1-based)
#   dominant_prop    — proportion of the dominant topic
banner("Export 1 — Document-topic proportions (stm_theta.csv)")
theta     <- stm_model$theta                     # N × K matrix
top_idx   <- apply(theta, 1, which.max)
top_prop  <- apply(theta, 1, max)
topic_cols          <- as.data.frame(theta)
colnames(topic_cols) <- paste0("topic_", seq_len(ncol(theta)))
theta_df <- data.frame(
page_id        = out$meta$page_id,
audience       = as.character(out$meta$audience),
domain         = out$meta$domain,
topic_cols,
dominant_topic = top_idx,
dominant_prop  = round(top_prop, 6),
stringsAsFactors = FALSE
)
theta_path <- file.path(OUTPUT_DIR, "stm_theta.csv")
write.csv(theta_df, theta_path, row.names = FALSE)
cat(sprintf("  Rows : %d  |  Columns : %d\n", nrow(theta_df), ncol(theta_df)))
cat(sprintf("  Saved → %s\n", normalizePath(theta_path)))
# =============================================================================
# EXPORT 2 — Topic term lists  (FREX + Prob)
# =============================================================================
# For every topic, extract the top-N terms under two ranking schemes:
#
#   Prob  — highest probability in the topic distribution (most common words)
#   FREX  — Frequency × Exclusivity: terms that are both frequent AND
#            distinctive to this topic.  Best for labelling / interpretation.
#
# Columns:
#   topic_id   — integer 1 … K
#   rank       — 1 … N_TERMS
#   prob_term  — top term by probability
#   frex_term  — top term by FREX
banner("Export 2 — Topic term lists (stm_topic_terms.csv)")
N_TERMS <- 20
labels  <- labelTopics(stm_model, n = N_TERMS)
# labelTopics() returns different field names depending on whether the model
# was fitted with or without a content covariate:
#
#   Prevalence-only model  →  $prob  [K × n],  $frex  [K × n]
#   Content-covariate model → $topics [K × n],  no $prob / $frex
#
# Detect which schema is present and pick the right matrices so this script
# works correctly regardless of which model type was fitted.
has_prob   <- !is.null(labels$prob)   && length(dim(labels$prob))   == 2L
has_topics <- !is.null(labels$topics) && length(dim(labels$topics)) == 2L
if (has_prob) {
prob_mat <- labels$prob
frex_mat <- labels$frex   # also present in prevalence-only model
cat("  labelTopics schema : prevalence-only  ($prob / $frex)\n")
} else if (has_topics) {
prob_mat <- labels$topics
frex_mat <- labels$topics   # no separate FREX in content-covariate model
cat("  labelTopics schema : content-covariate  ($topics)\n")
} else {
stop("labelTopics() returned an unrecognised structure.\n",
"  Available fields: ", paste(names(labels), collapse=", "), "\n",
"  Run str(labels) and report to developer.")
}
extract_terms <- function(mat, t, n) {
row <- mat[t, ]
as.character(row)[seq_len(n)]
}
terms_df <- do.call(rbind, lapply(seq_len(K), function(t) {
data.frame(
topic_id  = t,
rank      = seq_len(N_TERMS),
prob_term = extract_terms(prob_mat, t, N_TERMS),
frex_term = extract_terms(frex_mat, t, N_TERMS),
stringsAsFactors = FALSE
)
}))
terms_path <- file.path(OUTPUT_DIR, "stm_topic_terms.csv")
write.csv(terms_df, terms_path, row.names = FALSE)
cat(sprintf("  Rows : %d  (K=%d × %d terms × 2 metrics)\n",
nrow(terms_df), K, N_TERMS))
cat(sprintf("  Saved → %s\n", normalizePath(terms_path)))
# =============================================================================
# EXPORT 3 — Audience prevalence effects  (from estimateEffect)
# =============================================================================
# prev_df was built in 03_fit_model.R.  Here it is written to CSV exactly as-is
# (topic_id, frex_label, estimate, std_err, ci_lower, ci_upper, significant,
#  direction) so that 03b_import_stm.py can merge the statistical results back
# into the SQLite topic_audience_profile table.
banner("Export 3 — Audience prevalence effects (stm_prevalence.csv)")
prev_path <- file.path(OUTPUT_DIR, "stm_prevalence.csv")
write.csv(prev_df, prev_path, row.names = FALSE)
cat(sprintf("  Rows : %d  |  Significant: %d\n",
nrow(prev_df), sum(prev_df$significant)))
cat(sprintf("  Saved → %s\n", normalizePath(prev_path)))
# Quick console summary
cat("\n  Significant topics (|effect| ranked):\n")
sig <- prev_df[prev_df$significant, ]
sig <- sig[order(abs(sig$estimate), decreasing = TRUE), ]
if (nrow(sig) == 0) {
cat("  (none)\n")
} else {
print(sig[, c("topic_id", "frex_label", "estimate", "direction")],
row.names = FALSE)
}
# =============================================================================
# EXPORT 4 — Content covariate word log-odds  (H1c — sageLabels)
# =============================================================================
# Only produced when BOTH_STRATEGY = "exclude" (binary audience factor).
#
# sageLabels() returns, for each topic and each audience level, the words with
# the highest log-odds relative to the corpus background.  These are the words
# that are most distinctively *used* by client vs worker pages when discussing
# a particular topic — evidence for H1c (Strategic Hypervisibility).
#
# Columns:
#   topic_id  — integer 1 … K
#   audience  — "client" or "worker"
#   rank      — 1 … N_SAGE
#   term      — distinctive word
#
# NOTE: sageLabels() can be slow for large K.  Results are therefore cached to
#       stm_sage.rds alongside the CSV.  Delete the .rds to force a re-run.
banner("Export 4 — Content covariate word log-odds (stm_content.csv)")
content_path <- file.path(OUTPUT_DIR, "stm_content.csv")
sage_rds     <- file.path(OUTPUT_DIR, "stm_sage.rds")
if (BOTH_STRATEGY != "exclude") {
cat("  Skipped: BOTH_STRATEGY = \"third_level\" — no binary content covariate.\n")
cat("  (stm_content.csv not written)\n")
} else {
N_SAGE <- 15
if (file.exists(sage_rds)) {
cat("  Loading cached sageLabels (delete stm_sage.rds to re-run).\n")
sage <- readRDS(sage_rds)
} else {
cat("  Running sageLabels() — this may take a minute ...\n")
sage <- sageLabels(stm_model, n = N_SAGE)
saveRDS(sage, sage_rds)
cat(sprintf("  Cached → %s\n", sage_rds))
}
# sageLabels() API changed across stm versions.  Two known layouts:
#
#   Layout A (older)  sage$wordcov$<covariate>[[level_idx]]  → K × n matrix
#   Layout B (newer)  sage$plab[[level_idx + 1]]             → K × n matrix
#                     (plab[[1]] is the baseline / overall)
#
# extract_sage_mat() tries both and returns the first K × n matrix it finds,
# or NULL if neither works (caller falls back to labelTopics()$topics).
extract_sage_mat <- function(sage, cov_name, level_idx, K) {
# Layout A
wc  <- sage$wordcov[[cov_name]]
if (!is.null(wc) && is.list(wc) && length(wc) >= level_idx) {
mat <- wc[[level_idx]]
if (!is.null(mat) && length(dim(mat)) == 2L && nrow(mat) == K)
return(mat)
}
# Layout B
if (!is.null(sage$plab) && length(sage$plab) >= level_idx + 1L) {
mat <- sage$plab[[level_idx + 1L]]
if (!is.null(mat) && length(dim(mat)) == 2L && nrow(mat) == K)
return(mat)
}
NULL  # unrecognised structure
}
aud_levels <- c("client", "worker")
cat(sprintf("  sage top-level names: %s\n",
paste(names(sage), collapse = ", ")))
content_df <- do.call(rbind, lapply(seq_along(aud_levels), function(a) {
mat <- extract_sage_mat(sage, "audience", a, K)
do.call(rbind, lapply(seq_len(K), function(t) {
term_vals <- if (!is.null(mat)) {
as.character(mat[t, ])[seq_len(N_SAGE)]
} else {
# Fallback: overall top terms from labelTopics() (not log-odds).
# Use prob_mat which is already schema-aware (set above in Export 2).
as.character(prob_mat[t, ])[seq_len(N_SAGE)]
}
data.frame(
topic_id = t,
audience = aud_levels[a],
rank     = seq_len(N_SAGE),
term     = term_vals,
stringsAsFactors = FALSE
)
}))
}))
if (is.null(extract_sage_mat(sage, "audience", 1L, K))) {
warning(
"sageLabels() structure not recognised in this stm version.\n",
"  stm_content.csv uses labelTopics()$topics as fallback (no log-odds).\n",
"  Run str(sage, max.level=2) and share output to get a proper fix."
)
}
write.csv(content_df, content_path, row.names = FALSE)
cat(sprintf("  Rows : %d  (K=%d × 2 audiences × %d terms)\n",
nrow(content_df), K, N_SAGE))
cat(sprintf("  Saved → %s\n", normalizePath(content_path)))
# Show top-5 client and worker words for each topic
cat("\n  Per-topic content divergence (top 5 terms each side):\n")
cat(sprintf("  %-8s  %-35s  %-35s\n", "Topic", "CLIENT words", "WORKER words"))
cat("  ", paste(rep("-", 82), collapse = ""), "\n", sep = "")
for (t in seq_len(K)) {
cl_words <- paste(content_df$term[
content_df$topic_id == t & content_df$audience == "client" &
content_df$rank <= 5], collapse = ", ")
wk_words <- paste(content_df$term[
content_df$topic_id == t & content_df$audience == "worker" &
content_df$rank <= 5], collapse = ", ")
cat(sprintf("  T%-7d  %-35s  %-35s\n", t,
substr(cl_words, 1, 35), substr(wk_words, 1, 35)))
}
}
# =============================================================================
# SUMMARY
# =============================================================================
banner("Export summary")
exported <- c(
theta_path,
terms_path,
prev_path,
if (BOTH_STRATEGY == "exclude") content_path else NULL
)
cat("  Files written:\n")
for (f in exported) {
sz <- file.info(f)$size
cat(sprintf("    %-55s  %6.1f KB\n",
basename(f), sz / 1024))
}
cat("\n  ✓ 04_export.R complete.\n")
cat("  → Python next steps:\n")
cat("      python3 src2/03b_import_stm.py   — load results into SQLite\n")
cat("      python3 src2/04_step1_figures.py — regenerate figures\n\n")
if (!exists("OUTPUT_DIR")) {
source("00_config.R")
}
load_packages()   # loads stm, dplyr, ggplot2 etc. from 00_config.R
# Additional packages needed for robustness checks
suppressPackageStartupMessages({
library(tidyr)
library(tibble)
library(purrr)
library(lsa)        # cosine similarity — install.packages("lsa") if missing
library(grid)
library(gridExtra)
})
ROB_DIR <- file.path(OUTPUT_DIR, "robustness")
dir.create(ROB_DIR, showWarnings = FALSE, recursive = TRUE)
banner("06 — STM Robustness Checks")
require_file(OUT_RDS,
"Run 01_prepare.R first to create the processed corpus.")
require_file(MODEL_RDS,
"Run 03_fit_model.R first to fit the main model.")
out        <- readRDS(OUT_RDS)
main_model <- readRDS(MODEL_RDS)
cat("  Main model loaded: K =", main_model$settings$dim$K,
", init =", main_model$settings$init$mode, "\n")
banner("1 — Goodness-of-fit metrics (main model)")
coh  <- semanticCoherence(main_model, out$documents)
excl <- exclusivity(main_model)
fit_main <- tibble(
topic        = seq_len(main_model$settings$dim$K),
coherence    = coh,
exclusivity  = excl
)
cat("  Mean semantic coherence :", round(mean(coh), 2), "\n")
cat("  Mean exclusivity        :", round(mean(excl), 2), "\n")
cat("  Coherence SD            :", round(sd(coh), 2), "\n")
cat("  Exclusivity SD          :", round(sd(excl), 2), "\n")
cat("\n  Computing held-out likelihood (this may take a moment)...\n")
set.seed(SEED)
heldout <- make.heldout(out$documents, out$vocab,
proportion = 0.10, seed = SEED)
ho_main <- eval.heldout(main_model, heldout$missing)
cat("  Held-out log-likelihood :", round(ho_main$expected.heldout, 4), "\n")
resid_main <- checkResiduals(main_model, out$documents)
cat("  Residual dispersion     :", round(resid_main$dispersion, 4), "\n")
cat("  (values close to 1.0 indicate adequate model specification)\n")
banner("2 — Seed-sensitivity analysis")
N_SEEDS       <- 10
SEED_POOL     <- c(42, 123, 256, 314, 555, 789, 1001, 1234, 2025, 9999)
ROBUSTNESS_K  <- K    # from 00_config.R
CONTENT_FORM  <- if (BOTH_STRATEGY == "exclude") ~ audience else NULL
rob_cache <- file.path(ROB_DIR, "robustness_models.rds")
if (file.exists(rob_cache)) {
cat("  Loading cached robustness models from", rob_cache, "\n")
rob_models <- readRDS(rob_cache)
} else {
cat(sprintf("  Fitting %d models with different seeds (K=%d)...\n",
N_SEEDS, ROBUSTNESS_K))
rob_models <- list()
for (i in seq_along(SEED_POOL)) {
s <- SEED_POOL[i]
cat(sprintf("    [%d/%d] seed = %d ... ", i, N_SEEDS, s))
t0 <- Sys.time()
rob_models[[paste0("seed_", s)]] <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = ROBUSTNESS_K,
prevalence = ~ audience,
content    = CONTENT_FORM,
data       = out$meta,
init.type  = "Spectral",
max.em.its = MAX_ITER,
seed       = s,
verbose    = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(rob_models, rob_cache)
cat("  Saved to", rob_cache, "\n")
}
cat("\n  Computing topic alignment (cosine similarity on beta matrices)...\n")
get_beta_matrix <- function(model) {
# Returns K x V matrix of log-transformed word probabilities
exp(model$beta$logbeta[[1]])
}
beta_main <- get_beta_matrix(main_model)
alignment_results <- map_dfr(names(rob_models), function(nm) {
beta_alt  <- get_beta_matrix(rob_models[[nm]])
# For each main-model topic, find the best-matching alternative topic
map_dfr(1:nrow(beta_main), function(k) {
sims <- apply(beta_alt, 1, function(row) {
lsa::cosine(beta_main[k, ], row)
})
tibble(
model        = nm,
main_topic   = k,
best_match   = which.max(sims),
cosine_sim   = max(sims)
)
})
})
# Summary statistics
alignment_summary <- alignment_results %>%
group_by(model) %>%
summarise(
mean_cosine = mean(cosine_sim),
min_cosine  = min(cosine_sim),
sd_cosine   = sd(cosine_sim),
topics_above_90 = sum(cosine_sim > 0.90),
topics_above_95 = sum(cosine_sim > 0.95),
.groups = "drop"
)
cat("\n  ── Topic alignment summary across seeds ──\n")
cat(sprintf("  Overall mean cosine similarity : %.4f\n",
mean(alignment_summary$mean_cosine)))
cat(sprintf("  Overall min cosine similarity  : %.4f\n",
min(alignment_summary$min_cosine)))
cat(sprintf("  Topics with cosine > 0.95 (avg): %.1f / %d\n",
mean(alignment_summary$topics_above_95), ROBUSTNESS_K))
write.csv(alignment_results,
file.path(ROB_DIR, "robustness_topic_alignment.csv"),
row.names = FALSE)
banner("3 — Initialisation comparison (Spectral vs. Random)")
random_cache <- file.path(ROB_DIR, "random_init_models.rds")
if (file.exists(random_cache)) {
cat("  Loading cached random-init models...\n")
random_models <- readRDS(random_cache)
} else {
N_RANDOM <- 5
RANDOM_SEEDS <- c(42, 123, 314, 789, 2025)
cat(sprintf("  Fitting %d random-init models for comparison...\n", N_RANDOM))
random_models <- list()
for (i in seq_along(RANDOM_SEEDS)) {
s <- RANDOM_SEEDS[i]
cat(sprintf("    [%d/%d] random init, seed = %d ... ", i, N_RANDOM, s))
t0 <- Sys.time()
random_models[[paste0("random_", s)]] <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = ROBUSTNESS_K,
prevalence = ~ audience,
content    = CONTENT_FORM,
data       = out$meta,
init.type  = "Random",
max.em.its = MAX_ITER,
seed       = s,
verbose    = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(random_models, random_cache)
}
banner("4 — Convergence sensitivity")
iter_cache <- file.path(ROB_DIR, "iter_sensitivity_models.rds")
if (file.exists(iter_cache)) {
cat("  Loading cached iteration-sensitivity models...\n")
iter_models <- readRDS(iter_cache)
} else {
ITER_VALUES <- c(75, 100, 150, 200, 300)
cat("  Fitting models with different EM iteration budgets...\n")
iter_models <- list()
for (it in ITER_VALUES) {
cat(sprintf("    max.em.its = %d ... ", it))
t0 <- Sys.time()
iter_models[[paste0("iter_", it)]] <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = ROBUSTNESS_K,
prevalence = ~ audience,
content    = CONTENT_FORM,
data       = out$meta,
init.type  = "Spectral",
max.em.its = it,
seed       = SEED,
verbose    = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(iter_models, iter_cache)
}
banner("5 — Sigma prior sensitivity")
sigma_cache <- file.path(ROB_DIR, "sigma_sensitivity_models.rds")
if (file.exists(sigma_cache)) {
cat("  Loading cached sigma-sensitivity models...\n")
sigma_models <- readRDS(sigma_cache)
} else {
SIGMA_VALUES <- c(0, 0.5, 1.0, 5.0, 10.0)
cat("  Fitting models with different sigma.prior values...\n")
sigma_models <- list()
for (sp in SIGMA_VALUES) {
cat(sprintf("    sigma.prior = %.1f ... ", sp))
t0 <- Sys.time()
sigma_models[[paste0("sigma_", sp)]] <- stm(
documents   = out$documents,
vocab       = out$vocab,
K           = ROBUSTNESS_K,
prevalence  = ~ audience,
content     = CONTENT_FORM,
data        = out$meta,
init.type   = "Spectral",
max.em.its  = MAX_ITER,
seed        = SEED,
sigma.prior = sp,
verbose     = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(sigma_models, sigma_cache)
}
sigma_cache <- file.path(ROB_DIR, "sigma_sensitivity_models.rds")
if (file.exists(sigma_cache)) {
cat("  Loading cached sigma-sensitivity models...\n")
sigma_models <- readRDS(sigma_cache)
} else {
SIGMA_VALUES <- c(0, 0.5, 1.0)
cat("  Fitting models with different sigma.prior values...\n")
sigma_models <- list()
for (sp in SIGMA_VALUES) {
cat(sprintf("    sigma.prior = %.1f ... ", sp))
t0 <- Sys.time()
sigma_models[[paste0("sigma_", sp)]] <- stm(
documents   = out$documents,
vocab       = out$vocab,
K           = ROBUSTNESS_K,
prevalence  = ~ audience,
content     = CONTENT_FORM,
data        = out$meta,
init.type   = "Spectral",
max.em.its  = MAX_ITER,
seed        = SEED,
sigma.prior = sp,
verbose     = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(sigma_models, sigma_cache)
}
banner("6 — Comprehensive fit metrics")
