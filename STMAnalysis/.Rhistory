cat("  ║  3. Then run: 03_fit_model.R                                     ║ \n")
cat("  ╚══════════════════════════════════════════════════════════════════╝ \n\n")
source("00_config.R")
load_packages()
banner("03 — Fitting the final STM")
require_file(OUT_RDS, hint = "Run 01_prepare.R first")
out <- readRDS(OUT_RDS)
cat(sprintf("  Loaded out.rds  (documents=%d  vocab=%d)\n",
length(out$documents), length(out$vocab)))
cat(sprintf("  Fitting with K = %d  |  max.em.its = %d  |  seed = %d\n",
K, MAX_ITER, SEED))
if (BOTH_STRATEGY == "exclude") {
cat("  Prevalence = ~audience  +  Content = ~audience  (binary contrast)\n\n")
} else {
cat("  Prevalence = ~audience  (no content covariate — three-level audience)\n\n")
}
banner("Step 1 — Fitting final model (this takes a few minutes)")
content_formula <- if (BOTH_STRATEGY == "exclude") ~ audience else NULL
t_fit <- system.time({
stm_model <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = K,
prevalence = ~ audience,
content    = content_formula,
data       = out$meta,
max.em.its = MAX_ITER,
init.type  = "Spectral",
seed       = SEED,
verbose    = TRUE
)
})
k <- 25
K <- 25
cat(sprintf("  Loaded out.rds  (documents=%d  vocab=%d)\n",
length(out$documents), length(out$vocab)))
