significant = abs(row["Estimate"]) > z_crit * row["Std. Error"],
direction   = ifelse(row["Estimate"] > 0, "worker", "client"),
stringsAsFactors = FALSE
)
})
prev_df <- do.call(rbind, Filter(Negate(is.null), prev_list))
rownames(prev_df) <- NULL
