verbose    = TRUE
)
})
saveRDS(stm_model, MODEL_RDS)
cat(sprintf("\n  Model fitted in %.0f seconds.\n", t_fit["elapsed"]))
cat(sprintf("  Saved → %s\n", normalizePath(MODEL_RDS)))
# Topic proportion overview
plot(stm_model,
type     = "summary",
n        = 10,
main     = sprintf("Final STM (K=%d) — Topic Proportions", K),
text.cex = 0.75)
banner("Step 2 — Topic labels  (FREX recommended for naming)")
labels <- labelTopics(stm_model, n = 10)
print(labels)
# Compare two topics side by side (update topic IDs after reading labels above)
plot(stm_model, type = "perspectives", topics = c(1, 2))
# Compare two topics side by side (update topic IDs after reading labels above)
plot(stm_model, type = "perspectives", topics = c(1, 2))
# Compare two topics side by side (update topic IDs after reading labels above)
plot(stm_model, type = "perspectives", topics = c(1, 2))
# findThoughts: the documents most representative of each topic
# Use these to validate the FREX label before coding (Nelson 2020 Step 2).
banner("Step 2b — Representative documents (findThoughts)")
corpus_df <- read.csv(CORPUS_CSV, stringsAsFactors = FALSE)
# After prepDocuments some rows may have been dropped — align on page_id
aligned_texts <- corpus_df$tokens[match(out$meta$page_id, corpus_df$page_id)]
for (t in seq_len(K)) {
thoughts <- findThoughts(stm_model, texts = aligned_texts, topics = t, n = 2)
cat(sprintf("\n  Topic %2d  FREX: %s\n",
t, paste(labels$frex[t, 1:5], collapse=", ")))
for (i in seq_along(thoughts$docs[[1]])) {
cat(sprintf("    [%d] %s…\n", i, substr(thoughts$docs[[1]][i], 1, 160)))
}
}
banner("Step 3 — Prevalence effects: estimateEffect()  [H1a / H1b]")
cat("  Estimating audience effects on topic prevalence (nsims=500) ...\n")
prevalence_est <- estimateEffect(
formula     = 1:K ~ audience,
stmobj      = stm_model,
metadata    = out$meta,
uncertainty = "Global",
nsims       = 500
)
summary(prevalence_est)
# Coefficient plot — each topic is a point with 95% CI
# Left of zero = more client-prevalent; right = more worker-prevalent
plot(
prevalence_est,
covariate      = "audience",
topics         = 1:K,
model          = stm_model,
method         = "difference",
cov.value1     = "worker",
cov.value2     = "client",
xlab           = "More client  ←                →  More worker",
main           = sprintf("Audience prevalence effect per topic (K=%d, 95%% CI)", K),
labeltype      = "frex",
n              = 4,
verbose.labels = FALSE,
width          = 55
)
# Coefficient plot — each topic is a point with 95% CI
# Left of zero = more client-prevalent; right = more worker-prevalent
plot(
