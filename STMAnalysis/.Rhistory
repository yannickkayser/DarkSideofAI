DB_PATH    <- "../data/scraping_2.db"  # SQLite database (relative to STMAnalysis/)
OUTPUT_DIR <- "output/step_1/stm"
# Intermediate artefacts written by 01_prepare.R and read by later scripts
OUT_RDS    <- file.path(OUTPUT_DIR, "out.rds")
MODEL_RDS  <- file.path(OUTPUT_DIR, "stm_model.rds")
K        <- 20     # ← UPDATE after running 02_select_k.R
MAX_ITER <- 150    # EM iterations for the final model
SEED     <- 42
LOWER_THRESH   <- 5
STM_MIN_TOKENS <- 30L   # pages with fewer tokens are excluded (mirrors Python)
BOTH_STRATEGY <- "exclude"
N_CORES <- max(1L, parallel::detectCores() - 1L)
HYPOTHESIS_VOCAB <- list(
H1a = c("worker", "labour", "task", "job", "earn", "pay"),
H1b = c("autonomous", "machine", "automate", "automation", "algorithm", "pipeline"),
H1c = c("human", "quality", "oversight", "annotation", "label", "datum"),
H2  = c("flexible", "freedom", "schedule", "anytime", "balance"),
H3  = c("income", "opportunity", "skill", "earn", "grow"),
H4  = c("community", "connect", "together", "support"),
H5  = c("global", "worldwide", "region", "south", "africa")
)
load_packages <- function() {
suppressPackageStartupMessages({
library(stm)
library(dplyr)
library(ggplot2)
library(igraph)
library(DBI)
library(RSQLite)
library(jsonlite)
})
set.seed(SEED)
dir.create(OUTPUT_DIR, showWarnings = FALSE, recursive = TRUE)
invisible(NULL)
}
# Print a prominent section banner to the console
banner <- function(text) {
line <- paste(rep("─", 72), collapse = "")
cat(sprintf("\n%s\n  %s\n%s\n", line, text, line))
}
# Check that a required file exists; stop with a helpful message if not
require_file <- function(path, hint = NULL) {
if (!file.exists(path)) {
msg <- sprintf("Required file not found:\n  %s", path)
if (!is.null(hint)) msg <- paste0(msg, "\n  Hint: ", hint)
stop(msg, call. = FALSE)
}
invisible(path)
}
source("00_config.R")
load_packages()
banner("01 — Data preparation")
banner("Step 1 — Loading corpus from SQLite")
require_file(DB_PATH, hint = "Check that scraping_2.db is in the project root (one level above STMAnalysis/)")
con <- dbConnect(RSQLite::SQLite(), DB_PATH)
# ------------------------------------------------------------------
# Freshness check: warn if out.rds is older than pages_tfidf
# ------------------------------------------------------------------
# pages_tfidf.processed_at records when 00_preprocess.py last ran.
# If out.rds predates the most recent preprocessing, the model is
# based on stale data and this script should be re-run.
if (file.exists(OUT_RDS) && dbExistsTable(con, "pages_tfidf")) {
last_preprocess <- dbGetQuery(con,
"SELECT MAX(processed_at) AS ts FROM pages_tfidf")$ts
rds_mtime <- as.character(file.info(OUT_RDS)$mtime)
if (!is.na(last_preprocess) && rds_mtime < last_preprocess) {
warning(
"\n  ⚠  out.rds (", rds_mtime, ") is OLDER than the most recent ",
"preprocessing run (", last_preprocess, ").\n",
"  The model will be built on stale data unless you re-run this script.\n",
call. = FALSE
)
} else {
cat(sprintf("  ✓ out.rds is up to date (DB last preprocessed: %s)\n",
last_preprocess))
}
}
# Load excluded terms (vocabulary noise flagged by the Python pipeline)
excl_terms <- character(0)
if (dbExistsTable(con, "excluded_terms")) {
excl_terms <- dbGetQuery(con, "SELECT term FROM excluded_terms")$term
cat(sprintf("  Excluded terms loaded : %d\n", length(excl_terms)))
}
# Pull cleaned pages from corpus_view
raw_df <- dbGetQuery(con, "
SELECT  cv.page_id,
cv.audience,
cv.domain,
cv.company_id,
cv.platform_type,
cv.hq_region,
cv.unigrams,
cv.token_count
FROM    corpus_view cv
WHERE   cv.audience IN ('client', 'worker', 'both')
AND   cv.token_count >= ?
AND   cv.page_id NOT IN (
SELECT page_id FROM excluded_pages
)
ORDER   BY cv.page_id
", params = list(STM_MIN_TOKENS))
dbDisconnect(con)
cat(sprintf("  Pages loaded          : %d\n", nrow(raw_df)))
cat(sprintf("  NAs in unigrams       : %d\n", sum(is.na(raw_df$unigrams))))
cat(sprintf("  NAs in audience       : %d\n", sum(is.na(raw_df$audience))))
# Parse JSON token lists and apply excluded_terms filter
# Each unigrams value looks like: '["work","data","label",...]'
cat("  Parsing token lists...\n")
raw_df$tokens <- sapply(raw_df$unigrams, function(x) {
if (is.na(x) || nchar(x) == 0) return("")
toks <- tryCatch(fromJSON(x), error = function(e) character(0))
toks <- toks[!toks %in% excl_terms]
paste(toks, collapse = " ")
}, USE.NAMES = FALSE)
# Build corpus_df and meta_df in the shape the rest of the pipeline expects
corpus_df <- raw_df[, c("page_id", "audience", "domain", "tokens")]
meta_df   <- raw_df[, c("page_id", "audience", "domain",
"company_id", "platform_type", "hq_region")]
cat(sprintf("  Token parse complete  : %d pages\n", nrow(corpus_df)))
# ------------------------------------------------------------------
# Data quality spot-check
# ------------------------------------------------------------------
# Flags any remaining non-ASCII tokens so you can verify the Python
# cleaning worked correctly before committing to a long model run.
all_tokens <- unlist(strsplit(paste(corpus_df$tokens, collapse = " "), " "))
all_tokens <- all_tokens[nchar(all_tokens) > 0]
n_nonascii <- sum(grepl("[^\x01-\x7F]", all_tokens))
pct        <- 100 * n_nonascii / max(length(all_tokens), 1)
if (pct > 1) {
warning(sprintf(
"\n  ⚠  %.1f%% of tokens contain non-ASCII characters (%d / %d).\n",
pct, n_nonascii, length(all_tokens)
), "  Re-run src2/00_preprocess.py if this seems too high.\n",
call. = FALSE)
} else {
cat(sprintf("  ✓ Token quality OK — %.2f%% non-ASCII (expected < 1%%)\n", pct))
}
cat("\n  Audience distribution (raw):\n")
print(table(corpus_df$audience))
`%.%` <- paste0   # string concatenation helper
banner(paste0("Step 2 — Audience filtering (BOTH_STRATEGY = \"", BOTH_STRATEGY, "\")"))
n_both <- sum(corpus_df$audience == "both", na.rm = TRUE)
cat(sprintf("  'both' pages found   : %d  (%.1f%% of total)\n",
n_both, 100 * n_both / nrow(corpus_df)))
if (BOTH_STRATEGY == "exclude") {
corpus_df <- corpus_df[corpus_df$audience != "both", ]
meta_df   <- meta_df[meta_df$audience     != "both", ]
meta_df$audience <- factor(meta_df$audience, levels = c("client", "worker"))
cat(sprintf("  Pages after exclusion: %d\n", nrow(corpus_df)))
} else if (BOTH_STRATEGY == "third_level") {
meta_df$audience <- factor(meta_df$audience,
levels = c("client", "both", "worker"))
cat(sprintf("  Pages retained (including 'both'): %d\n", nrow(corpus_df)))
} else {
stop("Unknown BOTH_STRATEGY in 00_config.R: ", BOTH_STRATEGY)
}
cat("\n  Audience distribution after filtering:\n")
print(table(meta_df$audience))
banner("Step 3 — textProcessor()  [all flags FALSE — already pre-processed by spaCy]")
processed <- textProcessor(
documents         = corpus_df$tokens,
metadata          = meta_df,
lowercase         = FALSE,
removestopwords   = FALSE,
removenumbers     = FALSE,
removepunctuation = FALSE,
stem              = FALSE,
wordLengths       = c(3, Inf),
verbose           = TRUE
)
cat(sprintf("\n  Vocabulary before prepDocuments(): %d terms\n",
length(processed$vocab)))
banner(paste0("Step 4 — prepDocuments()  [lower.thresh = ", LOWER_THRESH, "]"))
out <- prepDocuments(
documents    = processed$documents,
vocab        = processed$vocab,
meta         = processed$meta,
lower.thresh = LOWER_THRESH,
verbose      = TRUE
)
n_dropped <- length(processed$documents) - length(out$documents)
cat(sprintf("\n  Documents remaining : %d\n",   length(out$documents)))
cat(sprintf("  Vocabulary remaining: %d terms\n", length(out$vocab)))
cat(sprintf("  Documents dropped   : %d  (became empty after pruning)\n", n_dropped))
banner("Step 5 — Saving out.rds")
saveRDS(out, OUT_RDS)
# Uncomment to see how many terms/docs are lost at each threshold value:
plotRemoved(processed$documents, lower.thresh.words = 1:30)
LOWER_THRESH   <- 3
STM_MIN_TOKENS <- 30L   # pages with fewer tokens are excluded (mirrors Python)
source("00_config.R")
banner(paste0("Step 4 — prepDocuments()  [lower.thresh = ", LOWER_THRESH, "]"))
# Uncomment to see how many terms/docs are lost at each threshold value:
plotRemoved(processed$documents, lower.thresh.words = 1:30)
out <- prepDocuments(
documents    = processed$documents,
vocab        = processed$vocab,
meta         = processed$meta,
lower.thresh = LOWER_THRESH,
verbose      = TRUE
)
n_dropped <- length(processed$documents) - length(out$documents)
cat(sprintf("\n  Documents remaining : %d\n",   length(out$documents)))
cat(sprintf("  Vocabulary remaining: %d terms\n", length(out$vocab)))
cat(sprintf("  Documents dropped   : %d  (became empty after pruning)\n", n_dropped))
banner("Step 5 — Saving out.rds")
saveRDS(out, OUT_RDS)
cat(sprintf("  Saved → %s\n", normalizePath(OUT_RDS)))
cat("\n  ✓ 01_prepare.R complete.\n")
cat("  → Corpus read directly from scraping_2.db via DBI — no CSV export needed.\n")
cat("  → Next: open and run 02_select_k.R\n\n")
View(out)
source("00_config.R")
load_packages()
banner("01b — Corpus diagnostics")
require_file(DB_PATH,
hint = "Check scraping_2.db is in the project root (one level above STMAnalysis/)")
con <- dbConnect(RSQLite::SQLite(), DB_PATH)
# Pull all pages (same query as 01_prepare.R, no audience filter yet)
raw_df <- dbGetQuery(con, "
SELECT  cv.page_id,
cv.audience,
cv.domain,
cv.unigrams,
cv.token_count
FROM    corpus_view cv
WHERE   cv.audience IN ('client', 'worker', 'both')
AND   cv.token_count >= ?
AND   cv.page_id NOT IN (SELECT page_id FROM excluded_pages)
ORDER   BY cv.page_id
", params = list(STM_MIN_TOKENS))
excl_terms <- if (dbExistsTable(con, "excluded_terms"))
dbGetQuery(con, "SELECT term FROM excluded_terms")$term else character(0)
dbDisconnect(con)
cat(sprintf("\n  Pages loaded: %d   |   Excluded terms: %d\n",
nrow(raw_df), length(excl_terms)))
# Parse token lists once — filter excluded terms
cat("  Parsing token lists...\n")
token_lists <- lapply(raw_df$unigrams, function(x) {
if (is.na(x) || nchar(x) == 0) return(character(0))
toks <- tryCatch(fromJSON(x), error = function(e) character(0))
toks[!toks %in% excl_terms]
})
names(token_lists) <- raw_df$page_id
# Flat vector of all tokens (used by several checks below)
all_tokens <- unlist(token_lists, use.names = FALSE)
cat(sprintf("  Total tokens : %s\n", format(length(all_tokens), big.mark = ",")))
cat(sprintf("  Unique tokens: %s\n", format(length(unique(all_tokens)), big.mark = ",")))
# =============================================================================
# CHECK 1 — Domain & audience overview
# =============================================================================
banner("Check 1 — Domain & audience overview")
overview <- raw_df[, c("domain", "audience")]
domain_tbl <- as.data.frame(table(domain = overview$domain,
audience = overview$audience))
domain_tbl <- domain_tbl[domain_tbl$Freq > 0, ]
domain_wide <- reshape(domain_tbl, idvar = "domain",
timevar = "audience", direction = "wide")
names(domain_wide) <- gsub("Freq\\.", "", names(domain_wide))
domain_wide[is.na(domain_wide)] <- 0
domain_wide$total <- rowSums(domain_wide[, -1], na.rm = TRUE)
domain_wide <- domain_wide[order(-domain_wide$total), ]
print(domain_wide, row.names = FALSE)
cat(sprintf("\n  Audience totals:\n"))
print(table(raw_df$audience))
# =============================================================================
# CHECK 2 — Token length distribution
# =============================================================================
# Short tokens (1–2 chars) are almost always noise: abbreviations, initials,
# or foreign-language syllables. wordLengths = c(3, Inf) in textProcessor
# would remove them; this check shows how many there are.
banner("Check 2 — Token length distribution")
tok_len <- nchar(all_tokens)
len_tbl <- table(cut(tok_len,
breaks = c(0, 1, 2, 3, 5, 8, 12, Inf),
labels = c("1", "2", "3", "4-5", "6-8", "9-12", "13+")))
len_df <- as.data.frame(len_tbl)
names(len_df) <- c("length", "count")
len_df$pct <- round(100 * len_df$count / sum(len_df$count), 2)
print(len_df, row.names = FALSE)
n_short <- sum(tok_len <= 2)
cat(sprintf("\n  ⚠  %s tokens (%.1f%%) are ≤ 2 characters.\n",
format(n_short, big.mark = ","),
100 * n_short / length(all_tokens)))
cat("  → Consider wordLengths = c(3, Inf) in textProcessor() inside 01_prepare.R\n")
# =============================================================================
# CHECK 3 — Top 100 most frequent tokens
# =============================================================================
# Scan this list for stop-words that slipped through, company names,
# boilerplate phrases, or foreign terms that should be excluded.
banner("Check 3 — Top 100 most frequent tokens")
freq_tbl <- sort(table(all_tokens), decreasing = TRUE)
top100    <- head(as.data.frame(freq_tbl), 100)
names(top100) <- c("token", "count")
top100$pct <- round(100 * top100$count / length(all_tokens), 3)
# Print in 4 columns for compact display
n  <- nrow(top100)
nc <- 4
nr <- ceiling(n / nc)
for (i in seq_len(nr)) {
idx <- seq(i, n, by = nr)
cols <- lapply(idx, function(j) {
sprintf("  %3d. %-18s %6d", j, top100$token[j], top100$count[j])
})
cat(paste(cols, collapse = "  "), "\n")
}
# =============================================================================
# CHECK 4 — Suspicious token patterns
# =============================================================================
# Flags tokens that match common noise patterns regardless of frequency.
banner("Check 4 — Suspicious token patterns")
unique_toks <- unique(all_tokens)
patterns <- list(
"Purely numeric"          = "^[0-9]+$",
"Numeric with punct"      = "^[0-9][0-9.,k%$€£]+$",
"Contains period (abbrev)"= "\\.",
"All uppercase (acronym)" = "^[A-Z]{2,}$",
"Single character"        = "^.$",
"Starts with dot/slash"   = "^[./]",
"URL fragment"            = "^(http|www|com|org|net)",
"Non-ASCII present"       = "[^\x01-\x7F]"
)
for (label in names(patterns)) {
matches <- unique_toks[grepl(patterns[[label]], unique_toks, perl = TRUE)]
n_match <- length(matches)
if (n_match == 0) {
cat(sprintf("  %-30s  0 unique tokens\n", label))
} else {
sample_n <- min(12, n_match)
sample_s <- paste(head(matches[order(nchar(matches))], sample_n), collapse = ", ")
cat(sprintf("  %-30s  %4d unique  |  e.g. %s\n",
label, n_match, sample_s))
}
}
# =============================================================================
# CHECK 5 — Non-ASCII token deep-dive
# =============================================================================
# Shows the most frequent non-ASCII tokens so you can decide which
# are legitimate (e.g. loanwords) and which are foreign-language artefacts.
banner("Check 5 — Non-ASCII tokens (top 40)")
nonascii_mask <- grepl("[^\x01-\x7F]", all_tokens)
if (sum(nonascii_mask) == 0) {
cat("  ✓ No non-ASCII tokens found — cleaning looks good!\n")
} else {
na_toks  <- all_tokens[nonascii_mask]
na_freq  <- sort(table(na_toks), decreasing = TRUE)
na_top   <- head(as.data.frame(na_freq), 40)
names(na_top) <- c("token", "count")
pct_all  <- round(100 * sum(nonascii_mask) / length(all_tokens), 3)
cat(sprintf("  %s non-ASCII token occurrences (%.3f%% of corpus)\n\n",
format(sum(nonascii_mask), big.mark = ","), pct_all))
print(na_top, row.names = FALSE)
cat("\n  → Add persistent offenders to excluded_terms in the Python pipeline,\n")
cat("    or ensure 00_preprocess.py ran with the latest Latin-filter fix.\n")
}
library(DBI); library(RSQLite)
con <- dbConnect(RSQLite::SQLite(), "../scraping_2.db")
dbGetQuery(con, "SELECT * FROM excluded_terms WHERE term LIKE '%é%' OR term LIKE '%å%' OR term LIKE '%ü%' LIMIT 20")
