plot(topic_corr,
main = sprintf("Topic correlation network (K=%d)", K))
install.packages(c("igraph", "ggraph", "tidygraph", "graphlayouts","ggrepel", "scales", "dplyr"))
library(igraph)
library(ggraph)
library(tidygraph)
library(graphlayouts)   # stress layout
library(ggrepel)        # label repulsion
library(scales)
library(dplyr)
topic_corr <- topicCorr(stm_model, method = "simple", cutoff = 0.01)
g <- graph_from_adjacency_matrix(
topic_corr$posadj,
mode     = "undirected",
weighted = TRUE,
diag     = FALSE
)
# Node size = mean topic proportion across all documents
topic_props <- colMeans(stm_model$theta)
# Short two-line labels for readability inside the figure
# Update these if you revise TOPIC_NAMES in 00_config.R
topic_labels <- c(
"1"  = "Freelance\nAI training",
"2"  = "Survey &\nresearch",
"3"  = "NLP &\ntext annotation",
"4"  = "B2B outsourcing\ncontent",
"5"  = "Technical\nAI tasks",
"6"  = "AI governance\n& oversight",
"7"  = "LLM evaluation\n& fine-tuning",
"8"  = "Cookie &\ntracking",
"9"  = "Computer vision\nlabeling",
"10" = "Privacy policy\n& ToS",
"11" = "Worker payments\n& earnings",
"12" = "Annotation\nplatform tools",
"13" = "Government &\ncompliance",
"14" = "Expert\nrecruitment",
"15" = "Enterprise\npartnerships",
"16" = "B2B workforce\nsolutions",
"17" = "Annotation API\n& dev tools",
"18" = "Human-AI\ndiscourse",
"19" = "Speech &\naudio data",
"20" = "Autonomous\nvehicles",
"21" = "AI deployment\n& synthetic data",
"22" = "Microwork\ncampaigns",
"23" = "Medical\nannotation",
"24" = "Search &\ncontent tagging",
"25" = "Machine learning\nconcepts"
)
# Thematic grouping — drives node colour.
# These map to your theoretical framework:
#   H1a (Labour Visibility Gap)  → worker-facing content
#   H1b (Automation Myth)        → AI/ML development + AI governance
#   H1c (Strategic Hypervisibility) → client-facing content + platform/enterprise
# Web boilerplate topics are flagged explicitly so reviewers can see
# the model identified them as a separate cluster.
thematic_groups <- c(
"1"  = "Worker-facing",
"2"  = "Research & data collection",
"3"  = "NLP & language tasks",
"4"  = "Client-facing",
"5"  = "AI/ML development",
"6"  = "AI governance",
"7"  = "AI/ML development",
"8"  = "Web boilerplate",
"9"  = "Vision & sensor tasks",
"10" = "Web boilerplate",
"11" = "Worker-facing",
"12" = "Platform & enterprise",
"13" = "Platform & enterprise",
"14" = "Worker-facing",
"15" = "Platform & enterprise",
"16" = "Client-facing",
"17" = "Platform & enterprise",
"18" = "AI governance",
"19" = "Vision & sensor tasks",
"20" = "Vision & sensor tasks",
"21" = "AI/ML development",
"22" = "Worker-facing",
"23" = "Research & data collection",
"24" = "Research & data collection",
"25" = "AI/ML development"
)
V(g)$label      <- topic_labels[as.character(seq_len(vcount(g)))]
V(g)$proportion <- topic_props
V(g)$group      <- thematic_groups[as.character(seq_len(vcount(g)))]
group_colours <- c(
"Worker-facing"              = "#2166AC",   # strong blue   → H1a
"Client-facing"              = "#D6604D",   # red           → H1c
"AI/ML development"          = "#74ADD1",   # light blue    → H1b
"AI governance"              = "#4393C3",   # mid blue      → H1b
"NLP & language tasks"       = "#4DAC26",   # green
"Vision & sensor tasks"      = "#A6D96A",   # light green
"Platform & enterprise"      = "#FEE08B",   # yellow
"Research & data collection" = "#FDAE61",   # orange
"Web boilerplate"            = "#BDBDBD"    # grey — de-emphasised
)
tg <- as_tbl_graph(g)
set.seed(SEED)   # ensures layout reproducibility
p_corr <- ggraph(tg, layout = "stress") +
# ── Edges ──────────────────────────────────────────────────────────────────
geom_edge_link(
aes(width = weight, alpha = weight),
colour      = "#555555",
show.legend = FALSE
) +
scale_edge_width_continuous(range = c(0.2, 2.8)) +
scale_edge_alpha_continuous(range = c(0.10, 0.65)) +
# ── Nodes ──────────────────────────────────────────────────────────────────
geom_node_point(
aes(size = proportion, fill = group),
shape  = 21,          # filled circle with border
colour = "white",
stroke = 0.7
) +
scale_size_continuous(
name   = "Corpus share",
range  = c(3, 15),
labels = percent_format(accuracy = 0.1)
) +
scale_fill_manual(
name   = "Thematic group",
values = group_colours
) +
# ── Labels ─────────────────────────────────────────────────────────────────
geom_node_text(
aes(label = label),
size           = 2.3,
colour         = "grey15",
repel          = TRUE,
max.overlaps   = 30,
point.padding  = 0.5,
box.padding    = 0.4,
segment.colour = "grey55",
segment.size   = 0.25,
segment.alpha  = 0.6,
family         = "sans"
) +
# ── Theme & labels ─────────────────────────────────────────────────────────
theme_graph(base_family = "sans") +
theme(
legend.position    = "right",
legend.title       = element_text(size = 8, face = "bold"),
legend.text        = element_text(size = 7),
legend.key.size    = unit(0.5, "cm"),
plot.title         = element_text(size = 11, face = "bold", hjust = 0.5),
plot.subtitle      = element_text(size = 7.5, hjust = 0.5,
colour = "grey40", lineheight = 1.3),
plot.caption       = element_text(size = 6.5, colour = "grey55"),
plot.background    = element_rect(fill = "white", colour = NA),
plot.margin        = margin(12, 12, 12, 12)
) +
labs(
title    = sprintf("Topic co-occurrence structure (K = %d)", K),
subtitle = paste0(
"Edge width and opacity proportional to positive correlation strength",
" (cutoff = 0.01)\n",
"Node size proportional to mean topic proportion across the corpus"
),
caption  = "Estimated via topicCorr() · stm R package (Roberts et al., 2019)"
) +
guides(
fill = guide_legend(override.aes = list(size = 4), ncol = 1),
size = guide_legend(ncol = 1)
)
out_dir <- file.path(OUTPUT_DIR, "stm")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
# PDF for thesis (cairo_pdf gives best font rendering in LaTeX)
ggsave(
filename = file.path(out_dir, "topic_correlation_network.pdf"),
plot     = p_corr,
width    = 11,
height   = 8.5,
device   = cairo_pdf
)
# PDF for thesis (cairo_pdf gives best font rendering in LaTeX)
ggsave(
filename = file.path(out_dir, "topic_correlation_network.pdf"),
plot     = p_corr,
width    = 11,
height   = 8.5,
device   = cairo_pdf
)
# PDF for thesis (cairo_pdf gives best font rendering in LaTeX)
ggsave(
filename = file.path(out_dir, "topic_correlation_network.pdf"),
plot     = p_corr,
width    = 11,
height   = 8.5,
device   = pdf
)
out_dir <- OUTPUT_DIR
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
# PDF for thesis (cairo_pdf gives best font rendering in LaTeX)
ggsave(
filename = file.path(out_dir, "topic_correlation_network.pdf"),
plot     = p_corr,
width    = 11,
