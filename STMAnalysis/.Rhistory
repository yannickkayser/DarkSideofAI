banner("Step 2 — Approach 3: coherence + exclusivity per K")
K_range <- c(10, 15, 20, 25, 30, 35)
cat(sprintf("  Testing K values: %s\n", paste(K_range, collapse = ", ")))
cat(sprintf("  Using %d parallel cores.\n", N_CORES))
manual_k_path <- file.path(OUTPUT_DIR, "manual_k_results.rds")
if (file.exists(manual_k_path)) {
cat("  Loading cached results (delete manual_k_results.rds to re-run).\n")
k_results <- readRDS(manual_k_path)
} else {
cat("  Fitting models — expected runtime ~5–10 min ...\n\n")
t_manual <- system.time({
k_results <- do.call(rbind, lapply(K_range, function(k) {
cat(sprintf("  Fitting K=%d ...\n", k))
m <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = k,
prevalence = ~ audience,
data       = out$meta,
max.em.its = 75,
init.type  = "Spectral",
seed       = SEED,
verbose    = FALSE
)
data.frame(
K      = k,
semcoh = mean(semanticCoherence(m, out$documents)),
exclus = mean(exclusivity(m)),
stringsAsFactors = FALSE
)
}))
})
saveRDS(k_results, manual_k_path)
cat(sprintf("\n  Done in %.0f seconds.  Saved → %s\n",
t_manual["elapsed"], manual_k_path))
}
cat("\n  Coherence + exclusivity results:\n")
print(k_results)
# Scatter plot: the "elbow" is the top-right corner of this cloud
plot(k_results$semcoh, k_results$exclus,
type = "b", pch = 16, col = "#2166ac",
xlab = "Semantic coherence (higher = better)",
ylab = "Exclusivity (higher = better)",
main = "K selection: coherence vs exclusivity trade-off")
text(k_results$semcoh, k_results$exclus,
labels = paste0("K=", k_results$K),
pos = 3, cex = 0.85, col = "#2166ac")
grid()
banner("Step 3 — Approach 2: searchK (5 K values, N=500, 75 iter)")
