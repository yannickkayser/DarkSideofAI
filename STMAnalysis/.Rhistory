banner("Step 5 — K selection summary")
# Helper: get held-out column regardless of stm version naming
get_heldout <- function(res) {
col <- if ("heldout" %in% names(res)) "heldout" else
grep("held", names(res), value = TRUE)[1]
unlist(res[[col]])
}
best3 <- k_results$K[
which.max(scale(k_results$semcoh) + scale(k_results$exclus))
]
best2 <- K_search2$results$K[which.max(get_heldout(K_search2$results))]
best1 <- K_search1$results$K[which.max(get_heldout(K_search1$results))]
cat(sprintf("  Approach 3 (best coherence+exclusivity balance) : K = %d\n", best3))
cat(sprintf("  Approach 2 (best held-out likelihood, N=500)    : K = %d\n", best2))
cat(sprintf("  Approach 1 (best held-out likelihood, K=10:50)  : K = %d\n", best1))
cat(sprintf("  Current K in 00_config.R                        : K = %d\n\n", K))
K        <- 30     # ← UPDATE after running 02_select_k.R
cat(sprintf("  Approach 2 (best held-out likelihood, N=500)    : K = %d\n", best2))
cat(sprintf("  Approach 1 (best held-out likelihood, K=10:50)  : K = %d\n", best1))
cat(sprintf("  Current K in 00_config.R                        : K = %d\n\n", K))
cat("  ╔══════════════════════════════════════════════════════════════════╗ \n")
cat("  ║  ACTION REQUIRED                                                 ║ \n")
cat("  ║                                                                  ║ \n")
cat("  ║  1. Review the plots and the values above.                       ║ \n")
