if (file.exists(sigma_cache)) {
cat("  Loading cached sigma-sensitivity models...\n")
sigma_models <- readRDS(sigma_cache)
} else {
SIGMA_VALUES <- c(0, 0.25, 0.5, 0.75, 1.0)
cat("  Fitting models with different sigma.prior values...\n")
sigma_models <- list()
for (sp in SIGMA_VALUES) {
cat(sprintf("    sigma.prior = %.2f ... ", sp))
t0 <- Sys.time()
sigma_models[[paste0("sigma_", sp)]] <- stm(
documents   = out$documents,
vocab       = out$vocab,
K           = ROBUSTNESS_K,
prevalence  = ~ audience,
content     = CONTENT_FORM,
data        = out$meta,
init.type   = "Spectral",
max.em.its  = MAX_ITER,
seed        = SEED,
sigma.prior = sp,
verbose     = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(sigma_models, sigma_cache)
}
banner("5b — TRUE seed sensitivity (random init across seeds)")
randseed_cache <- file.path(ROB_DIR, "randseed_models.rds")
if (file.exists(randseed_cache)) {
cat("  Loading cached random-seed models...\n")
randseed_models <- readRDS(randseed_cache)
} else {
cat(sprintf("  Fitting %d random-init models across SEED_POOL...\n", N_SEEDS))
randseed_models <- list()
for (i in seq_along(SEED_POOL)) {
s <- SEED_POOL[i]
cat(sprintf("    [%d/%d] random init, seed = %d ... ", i, N_SEEDS, s))
t0 <- Sys.time()
randseed_models[[paste0("randseed_", s)]] <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = ROBUSTNESS_K,
prevalence = ~ audience,
content    = CONTENT_FORM,
data       = out$meta,
init.type  = "Random",
max.em.its = MAX_ITER,
seed       = s,
verbose    = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat(elapsed, "min\n")
}
saveRDS(randseed_models, randseed_cache)
}
# Topic alignment: compare main model to each random-init variant
cat("\n  Computing random-init topic alignment...\n")
randseed_alignment <- map_dfr(names(randseed_models), function(nm) {
beta_alt <- get_beta_matrix(randseed_models[[nm]])
map_dfr(1:nrow(beta_main), function(k) {
sims <- apply(beta_alt, 1, function(row) lsa::cosine(beta_main[k, ], row))
tibble(
model       = nm,
main_topic  = k,
best_match  = which.max(sims),
cosine_sim  = max(sims)
)
})
})
randseed_summary <- randseed_alignment %>%
group_by(model) %>%
summarise(
mean_cosine      = mean(cosine_sim),
min_cosine       = min(cosine_sim),
topics_above_90  = sum(cosine_sim > 0.90),
topics_above_95  = sum(cosine_sim > 0.95),
.groups = "drop"
)
cat("\n  ── Random-init seed sensitivity ──\n")
cat(sprintf("  Mean cosine similarity across %d random-init seeds : %.4f\n",
N_SEEDS, mean(randseed_summary$mean_cosine)))
cat(sprintf("  SD of mean cosine across seeds                      : %.4f\n",
sd(randseed_summary$mean_cosine)))
cat(sprintf("  Avg topics with cosine > 0.90                        : %.1f / %d\n",
mean(randseed_summary$topics_above_90), ROBUSTNESS_K))
cat(sprintf("  Avg topics with cosine > 0.95                        : %.1f / %d\n",
mean(randseed_summary$topics_above_95), ROBUSTNESS_K))
cat("  Interpretation: variation here reflects GENUINE seed sensitivity.\n")
cat("  High cosine with random init = your topics are stable across local optima.\n")
write.csv(randseed_alignment,
file.path(ROB_DIR, "randseed_topic_alignment.csv"),
row.names = FALSE)
# Per-topic stability across random-init runs (which topics are most fragile?)
topic_stability <- randseed_alignment %>%
group_by(main_topic) %>%
summarise(
mean_cosine = mean(cosine_sim),
min_cosine  = min(cosine_sim),
sd_cosine   = sd(cosine_sim),
.groups = "drop"
) %>%
arrange(mean_cosine)
cat("\n  Most fragile topics (lowest mean cosine across random-init runs):\n")
print(head(topic_stability, 5))
write.csv(topic_stability,
file.path(ROB_DIR, "topic_stability_ranking.csv"),
row.names = FALSE)
banner("5c — K sensitivity (dispersion comparison at K = 25 vs. K = 30)")
k30_cache <- file.path(ROB_DIR, "k30_model.rds")
if (file.exists(k30_cache)) {
cat("  Loading cached K=30 model...\n")
k30_model <- readRDS(k30_cache)
} else {
cat("  Fitting comparison model at K = 30 ...\n")
t0 <- Sys.time()
k30_model <- stm(
documents  = out$documents,
vocab      = out$vocab,
K          = 30,
prevalence = ~ audience,
content    = CONTENT_FORM,
data       = out$meta,
init.type  = "Spectral",
max.em.its = MAX_ITER,
seed       = SEED,
verbose    = FALSE
)
elapsed <- round(difftime(Sys.time(), t0, units = "mins"), 1)
cat("    done in", elapsed, "min\n")
saveRDS(k30_model, k30_cache)
}
k30_disp <- tryCatch(checkResiduals(k30_model, out$documents)$dispersion,
error = function(e) NA_real_)
k30_coh  <- tryCatch(semanticCoherence(k30_model, out$documents),
error = function(e) NA_real_)
k30_excl <- tryCatch(exclusivity(k30_model),
error = function(e) rep(NA_real_, 30))
cat("\n  ── K comparison ──\n")
cat(sprintf("  K = 25  | coherence = %.2f | exclusivity = %.2f | dispersion = %.3f\n",
mean(coh, na.rm = TRUE),
mean(excl, na.rm = TRUE),
resid_main$dispersion))
cat(sprintf("  K = 30  | coherence = %.2f | exclusivity = %.2f | dispersion = %.3f\n",
mean(k30_coh, na.rm = TRUE),
mean(k30_excl, na.rm = TRUE),
k30_disp))
cat("  Interpretation: dispersion closer to 1 at a higher K suggests\n")
cat("  the original K = 25 was slightly under-specified. Report K = 25 as\n")
cat("  the primary model (chosen on coherence/exclusivity/interpretability)\n")
cat("  and K = 30 as a robustness check if topic structure is substantively\n")
cat("  equivalent.\n")
banner("6 — Comprehensive fit metrics")
compute_fit_metrics <- function(model, label, documents, vocab, heldout_obj) {
K_model <- model$settings$dim$K
coh <- tryCatch(
semanticCoherence(model, documents),
error = function(e) {
message("  coherence failed for ", label, ": ", e$message)
rep(NA_real_, K_model)
}
)
excl <- tryCatch(
exclusivity(model),
error = function(e) {
message("  exclusivity failed for ", label, ": ", e$message)
rep(NA_real_, K_model)
}
)
ho <- tryCatch(
eval.heldout(model, heldout_obj$missing)$expected.heldout,
error = function(e) NA_real_
)
resid <- tryCatch({
r <- checkResiduals(model, documents)
r$dispersion
}, error = function(e) NA_real_)
lb <- tryCatch(max(model$convergence$bound, na.rm = TRUE),
error = function(e) NA_real_)
converged <- tryCatch(isTRUE(model$convergence$converged),
error = function(e) NA)
n_iter    <- tryCatch(length(model$convergence$bound),
error = function(e) NA_integer_)
tibble(
model_label      = label,
mean_coherence   = if (all(is.na(coh)))  NA_real_ else mean(coh,  na.rm = TRUE),
sd_coherence     = if (all(is.na(coh)))  NA_real_ else sd(coh,    na.rm = TRUE),
mean_exclusivity = if (all(is.na(excl))) NA_real_ else mean(excl, na.rm = TRUE),
sd_exclusivity   = if (all(is.na(excl))) NA_real_ else sd(excl,   na.rm = TRUE),
heldout_ll       = ho,
dispersion       = resid,
lower_bound      = lb,
converged        = converged,
em_iterations    = n_iter
)
}
cat("  Computing fit metrics for all models...\n")
# Main model
all_metrics <- compute_fit_metrics(
main_model, "main (spectral, seed=42)", out$documents, out$vocab, heldout
)
# Seed variants
for (nm in names(rob_models)) {
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
rob_models[[nm]], nm, out$documents, out$vocab, heldout
))
}
# Random-init variants
for (nm in names(random_models)) {
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
random_models[[nm]], nm, out$documents, out$vocab, heldout
))
}
# Iteration variants
for (nm in names(iter_models)) {
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
iter_models[[nm]], nm, out$documents, out$vocab, heldout
))
}
# Sigma variants
for (nm in names(sigma_models)) {
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
sigma_models[[nm]], nm, out$documents, out$vocab, heldout
))
}
# Random-seed variants (TRUE seed sensitivity)
for (nm in names(randseed_models)) {
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
randseed_models[[nm]], nm, out$documents, out$vocab, heldout
))
}
# K = 30 comparison model
all_metrics <- bind_rows(all_metrics, compute_fit_metrics(
k30_model, "K30 (spectral, seed=42)", out$documents, out$vocab, heldout
))
write.csv(all_metrics, file.path(ROB_DIR, "robustness_fit_metrics.csv"),
row.names = FALSE)
cat("  Fit metrics saved to robustness_fit_metrics.csv\n")
cat("\n  ── Fit metrics summary ──\n")
print(all_metrics %>% select(model_label, mean_coherence, mean_exclusivity,
heldout_ll, dispersion, converged), n = 50)
banner("7 — Prevalence effect stability (estimateEffect across seeds)")
cat("  Estimating audience effects for each seed model...\n")
effect_stability <- map_dfr(names(rob_models), function(nm) {
ee <- tryCatch({
estimateEffect(1:ROBUSTNESS_K ~ audience,
stmobj = rob_models[[nm]],
metadata = out$meta,
uncertainty = "Global")
}, error = function(e) NULL)
if (is.null(ee)) return(tibble())
map_dfr(1:ROBUSTNESS_K, function(k) {
s <- summary(ee, topics = k)
coefs <- s$tables[[1]]
# Extract audience coefficient rows (skip intercept)
aud_rows <- coefs[grep("audience", rownames(coefs)), , drop = FALSE]
if (nrow(aud_rows) == 0) return(tibble())
tibble(
model      = nm,
topic      = k,
covariate  = rownames(aud_rows),
estimate   = aud_rows[, "Estimate"],
std_error  = aud_rows[, "Std. Error"],
p_value    = aud_rows[, "Pr(>|t|)"],
sig_05     = aud_rows[, "Pr(>|t|)"] < 0.05
)
})
})
if (nrow(effect_stability) > 0) {
# For each topic × covariate, count how often the effect is significant
effect_summary <- effect_stability %>%
group_by(topic, covariate) %>%
summarise(
mean_estimate  = mean(estimate),
sd_estimate    = sd(estimate),
prop_sig       = mean(sig_05),
sign_flips     = length(unique(sign(estimate))) > 1,
n_models       = n(),
.groups = "drop"
) %>%
arrange(topic)
cat("\n  ── Prevalence effect stability ──\n")
cat("  Topics where significance is consistent (p<.05 in >80% of seeds):\n")
stable <- effect_summary %>% filter(prop_sig > 0.80)
if (nrow(stable) > 0) print(stable, n = 50)
cat("\n  Topics with sign flips across seeds (fragile direction):\n")
fragile <- effect_summary %>% filter(sign_flips)
if (nrow(fragile) > 0) {
print(fragile, n = 50)
} else {
cat("  None — all topic effects maintain consistent direction.\n")
}
write.csv(effect_summary,
file.path(ROB_DIR, "robustness_prevalence_stability.csv"),
row.names = FALSE)
}
banner("8 — Generating diagnostic plots")
theme_thesis <- theme_minimal(base_size = 11) +
theme(
plot.title    = element_text(face = "bold", size = 12),
plot.subtitle = element_text(size = 10, colour = "grey40"),
legend.position = "bottom"
)
p1 <- ggplot(fit_main, aes(x = coherence, y = exclusivity)) +
geom_point(size = 2.5, colour = "#2C3E50") +
geom_text(aes(label = topic), vjust = -0.8, size = 3, colour = "grey40") +
geom_vline(xintercept = mean(fit_main$coherence),
linetype = "dashed", colour = "steelblue") +
geom_hline(yintercept = mean(fit_main$exclusivity),
linetype = "dashed", colour = "steelblue") +
labs(
title    = sprintf("Semantic Coherence vs. Exclusivity (K = %d)", ROBUSTNESS_K),
subtitle = "Dashed lines = means. Top-right quadrant = high-quality topics.",
x = "Semantic Coherence", y = "Exclusivity"
) +
theme_thesis
ggsave(file.path(ROB_DIR, "plot_coherence_exclusivity.pdf"),
p1, width = 8, height = 6)
p2 <- ggplot(alignment_results,
aes(x = factor(main_topic), y = model, fill = cosine_sim)) +
geom_tile() +
scale_fill_gradient2(low = "#E74C3C", mid = "#F39C12", high = "#27AE60",
midpoint = 0.90, limits = c(0.5, 1),
name = "Cosine\nSimilarity") +
labs(
title    = "Topic Stability Across Seeds",
subtitle = "Each cell = cosine similarity between main-model topic and best match in seed variant",
x = "Main Model Topic", y = "Seed Variant"
) +
theme_thesis +
theme(axis.text.x = element_text(size = 7))
ggsave(file.path(ROB_DIR, "plot_seed_stability.pdf"),
p2, width = 12, height = 6)
p2b <- ggplot(randseed_alignment,
aes(x = factor(main_topic), y = model, fill = cosine_sim)) +
geom_tile() +
scale_fill_gradient2(low = "#E74C3C", mid = "#F39C12", high = "#27AE60",
midpoint = 0.75, limits = c(0, 1),
name = "Cosine\nSimilarity") +
labs(
title    = "Topic Stability Across Random-Init Seeds (true seed sensitivity)",
subtitle = "Each cell = cosine similarity between main-model topic and best match in random-init variant",
x = "Main Model Topic", y = "Random-Init Seed Variant"
) +
theme_thesis +
theme(axis.text.x = element_text(size = 7))
ggsave(file.path(ROB_DIR, "plot_randseed_stability.pdf"),
p2b, width = 12, height = 6)
conv_df <- tibble(
iteration = seq_along(main_model$convergence$bound),
bound     = main_model$convergence$bound
)
p3 <- ggplot(conv_df, aes(x = iteration, y = bound)) +
geom_line(colour = "#2C3E50", linewidth = 0.8) +
labs(
title    = "ELBO Convergence (Main Model)",
subtitle = paste("Converged:", main_model$convergence$converged,
"| Final iteration:", nrow(conv_df)),
x = "EM Iteration", y = "Approximate Lower Bound (ELBO)"
) +
theme_thesis
ggsave(file.path(ROB_DIR, "plot_convergence.pdf"),
p3, width = 8, height = 5)
fit_comparison <- all_metrics %>%
mutate(
init_type = case_when(
grepl("^randseed_", model_label) ~ "Random (seed sensitivity)",
grepl("^random_",   model_label) ~ "Random (init)",
grepl("^sigma_",    model_label) ~ "Sigma variant",
grepl("^iter_",     model_label) ~ "Iter variant",
grepl("^K30",       model_label) ~ "K = 30",
grepl("^seed_",     model_label) ~ "Spectral (reproducibility)",
TRUE                             ~ "Main (spectral)"
)
)
p4a <- ggplot(fit_comparison, aes(x = mean_coherence, y = mean_exclusivity,
colour = init_type, shape = init_type)) +
geom_point(size = 3) +
labs(
title = "Model Fit: Coherence vs. Exclusivity Across Specifications",
x = "Mean Semantic Coherence", y = "Mean Exclusivity",
colour = "Specification", shape = "Specification"
) +
theme_thesis
ggsave(file.path(ROB_DIR, "plot_fit_comparison.pdf"),
p4a, width = 9, height = 6)
if (any(!is.na(fit_comparison$heldout_ll))) {
p5 <- ggplot(fit_comparison %>% filter(!is.na(heldout_ll)),
aes(x = reorder(model_label, heldout_ll),
y = heldout_ll, fill = init_type)) +
geom_col() +
coord_flip() +
labs(
title = "Held-Out Log-Likelihood Across Model Specifications",
x = NULL, y = "Held-Out Log-Likelihood",
fill = "Specification"
) +
theme_thesis
ggsave(file.path(ROB_DIR, "plot_heldout_comparison.pdf"),
p5, width = 10, height = 8)
}
banner("9 — Generating narrative summary")
sink(file.path(ROB_DIR, "robustness_summary.txt"))
cat("STM ROBUSTNESS CHECKS — SUMMARY REPORT\n")
cat("=" ,rep("=", 59), "\n", sep = "")
cat("Generated:", format(Sys.time(), "%Y-%m-%d %H:%M"), "\n")
cat("Model: K =", ROBUSTNESS_K, ", prevalence ~ audience, spectral init\n\n")
cat("1. GOODNESS-OF-FIT METRICS (Main Model)\n")
cat("-----------------------------------------\n")
cat(sprintf("   Semantic coherence  : mean = %.2f (SD = %.2f)\n",
mean(coh), sd(coh)))
cat(sprintf("   Exclusivity         : mean = %.2f (SD = %.2f)\n",
mean(excl), sd(excl)))
cat(sprintf("   Held-out log-lik.   : %.4f\n", ho_main$expected.heldout))
cat(sprintf("   Residual dispersion : %.4f\n", resid_main$dispersion))
cat("   Interpretation: Dispersion close to 1.0 suggests the model\n")
cat("   adequately captures the observed word-count variability.\n\n")
cat("2a. REPRODUCIBILITY (", N_SEEDS, " spectral-init seeds)\n", sep = "")
cat("-----------------------------------------\n")
cat(sprintf("   Mean topic alignment (cosine sim) : %.4f\n",
mean(alignment_summary$mean_cosine)))
cat("   Note: Spectral initialisation is deterministic, so variation\n")
cat("   across these seeds reflects only variational-inference\n")
cat("   tie-breaking. Near-identical results across seeds confirm\n")
cat("   PERFECT REPRODUCIBILITY of the spectral-init pipeline.\n\n")
cat("2b. TRUE SEED SENSITIVITY (", N_SEEDS, " random-init seeds)\n", sep = "")
cat("-----------------------------------------\n")
if (exists("randseed_summary")) {
cat(sprintf("   Mean cosine across random-init runs : %.4f\n",
mean(randseed_summary$mean_cosine)))
cat(sprintf("   SD of mean cosine across seeds      : %.4f\n",
sd(randseed_summary$mean_cosine)))
cat(sprintf("   Avg topics with cosine > 0.90       : %.1f / %d\n",
mean(randseed_summary$topics_above_90), ROBUSTNESS_K))
cat(sprintf("   Avg topics with cosine > 0.95       : %.1f / %d\n",
mean(randseed_summary$topics_above_95), ROBUSTNESS_K))
cat("   Interpretation: Random init exposes the model to different\n")
cat("   local optima. High cosine here = topics recover even when\n")
cat("   the optimiser is not steered by spectral decomposition.\n\n")
}
cat("3. INITIALISATION COMPARISON (Spectral vs. Random)\n")
cat("-----------------------------------------\n")
spectral_fit <- fit_comparison %>% filter(init_type == "Spectral")
random_fit   <- fit_comparison %>% filter(init_type == "Random")
cat(sprintf("   Spectral — mean coherence: %.2f, mean exclusivity: %.2f\n",
mean(spectral_fit$mean_coherence), mean(spectral_fit$mean_exclusivity)))
if (nrow(random_fit) > 0) {
cat(sprintf("   Random   — mean coherence: %.2f, mean exclusivity: %.2f\n",
mean(random_fit$mean_coherence), mean(random_fit$mean_exclusivity)))
}
cat("   Interpretation: Spectral initialisation provides a principled,\n")
cat("   deterministic starting point. If spectral models match or exceed\n")
cat("   random-init fit, this supports the chosen initialisation strategy.\n\n")
cat("4. CONVERGENCE DIAGNOSTICS\n")
cat("-----------------------------------------\n")
cat(sprintf("   Main model converged: %s (after %d iterations)\n",
main_model$convergence$converged,
length(main_model$convergence$bound)))
cat("   See plot_convergence.pdf for the ELBO trajectory.\n\n")
cat("4b. K SENSITIVITY (K = 25 vs K = 30)\n")
cat("-----------------------------------------\n")
if (exists("k30_disp")) {
cat(sprintf("   K = 25 : dispersion = %.3f, coherence = %.2f, exclusivity = %.2f\n",
resid_main$dispersion, mean(coh, na.rm = TRUE), mean(excl, na.rm = TRUE)))
cat(sprintf("   K = 30 : dispersion = %.3f, coherence = %.2f, exclusivity = %.2f\n",
k30_disp, mean(k30_coh, na.rm = TRUE), mean(k30_excl, na.rm = TRUE)))
cat("   Interpretation: residual dispersion > 1 at K = 25 suggests the\n")
cat("   model may be slightly under-specified. Refit at K = 30 is\n")
cat("   provided as a robustness check; report K = 25 as primary if its\n")
cat("   topics are more interpretable and substantively equivalent.\n\n")
}
cat("5. SIGMA PRIOR SENSITIVITY\n")
cat("-----------------------------------------\n")
sigma_fit <- fit_comparison %>% filter(init_type == "Sigma variant")
if (nrow(sigma_fit) > 0) {
cat(sprintf("   Coherence range : [%.2f, %.2f]\n",
min(sigma_fit$mean_coherence), max(sigma_fit$mean_coherence)))
cat(sprintf("   Exclusivity range : [%.2f, %.2f]\n",
min(sigma_fit$mean_exclusivity), max(sigma_fit$mean_exclusivity)))
}
cat("   Interpretation: Modest variation across sigma.prior values\n")
cat("   indicates results are not driven by the prior specification.\n\n")
if (exists("effect_summary") && nrow(effect_summary) > 0) {
cat("6. PREVALENCE EFFECT STABILITY\n")
cat("-----------------------------------------\n")
n_stable <- sum(effect_summary$prop_sig > 0.80)
n_fragile <- sum(effect_summary$sign_flips)
cat(sprintf("   Effects significant in >80%% of seeds : %d / %d\n",
n_stable, nrow(effect_summary)))
cat(sprintf("   Effects with sign flips              : %d / %d\n",
n_fragile, nrow(effect_summary)))
cat("   Interpretation: Consistent significance and direction across\n")
cat("   seeds supports the reliability of prevalence findings.\n")
}
cat("\n\nFILES PRODUCED\n")
cat("-----------------------------------------\n")
cat("   robustness_fit_metrics.csv          — Numeric fit table (all models)\n")
cat("   robustness_topic_alignment.csv      — Spectral-seed cosine sims\n")
cat("   randseed_topic_alignment.csv        — Random-init cosine sims\n")
cat("   topic_stability_ranking.csv         — Per-topic fragility ranking\n")
cat("   robustness_prevalence_stability.csv — Effect robustness\n")
cat("   plot_coherence_exclusivity.pdf      — Main model topic quality\n")
cat("   plot_seed_stability.pdf             — Spectral-seed heatmap\n")
cat("   plot_randseed_stability.pdf         — Random-init heatmap (true test)\n")
cat("   plot_convergence.pdf                — ELBO trajectory\n")
cat("   plot_fit_comparison.pdf             — Multi-specification comparison\n")
cat("   plot_heldout_comparison.pdf         — Held-out LL comparison\n")
sink()
cat("  Summary written to robustness_summary.txt\n")
banner("06 — Robustness checks complete")
cat("  All outputs saved to:", ROB_DIR, "\n")
